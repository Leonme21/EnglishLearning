@page "/lessons"
@attribute [Authorize]
@inject LessonService LessonService
@inject UserSession Session
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Lecciones - English Learning</PageTitle>

<RequirePlacement>
    <div class="lessons-container">
        <h1 class="mb-4">Catálogo de Lecciones</h1>
        
        <div class="tabs mb-4">
            @foreach (var level in _levels)
            {
                <button class="tab-btn @(level == _activeLevel ? "active" : "")" @onclick="() => SelectLevel(level)">
                    @level
                </button>
            }
        </div>

        @if (_isLoading)
        {
            <div class="text-center py-5"><span class="spinner-small" style="width:3rem;height:3rem;border-width:4px;"></span></div>
        }
        else if (_lessons.Count == 0)
        {
            <div class="glass-panel text-center p-5">
                <h3>No hay lecciones disponibles para este nivel.</h3>
                <p class="text-muted mt-2">Estamos creando más contenido.</p>
            </div>
        }
        else
        {
            <div class="lessons-grid">
                @foreach (var lesson in _lessons)
                {
                    <div class="glass-panel lesson-card fade-in" @key="lesson.Id">
                        <div class="lesson-header">
                            <span class="level-badge-small">@lesson.Nivel</span>
                            <span class="text-muted text-sm">@lesson.Ejercicios.Count ejercicios</span>
                        </div>
                        <h3 class="mt-2 mb-2">@lesson.Titulo</h3>
                        <p class="text-muted mb-4">@lesson.Descripcion</p>
                        
                        <button class="btn btn-primary w-100 mt-auto" @onclick="() => StartLesson(lesson.Id)">
                            Empezar Lección
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</RequirePlacement>

<style>
.tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
}
.tab-btn {
    background: var(--surface-color);
    border: 1px solid var(--surface-border);
    color: var(--text-muted);
    padding: 0.5rem 1.5rem;
    border-radius: 2rem;
    cursor: pointer;
    font-weight: 600;
    transition: all var(--transition-fast);
    flex-shrink: 0;
}
.tab-btn:hover {
    background: hsla(var(--primary-h), var(--primary-s), var(--primary-l), 0.1);
    color: var(--text-main);
}
.tab-btn.active {
    background: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
}
.lessons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
}
.lesson-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    transition: transform var(--transition-bounce);
}
.lesson-card:hover {
    transform: translateY(-5px);
}
.lesson-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
</style>

@code {
    private bool _isLoading = true;
    private string _activeLevel = "A1";
    private readonly string[] _levels = new[] { "A1", "A2", "B1", "B2", "C1" };
    private List<LessonDto> _lessons = new();

    protected override async Task OnInitializedAsync()
    {
        if (Session.NivelActual != "SinAsignar" && _levels.Contains(Session.NivelActual))
        {
            _activeLevel = Session.NivelActual;
        }
        await LoadLessons();
    }

    private async Task SelectLevel(string level)
    {
        if (_activeLevel == level) return;
        _activeLevel = level;
        await LoadLessons();
    }

    private async Task LoadLessons()
    {
        _isLoading = true;
        StateHasChanged();
        
        var res = await LessonService.GetLessonsByLevelAsync(_activeLevel);
        if (res.IsSuccess && res.Data != null)
        {
            _lessons = res.Data;
        }
        else
        {
            _lessons.Clear();
            ToastService.ShowError("Error al cargar lecciones.");
        }
        _isLoading = false;
    }

    private void StartLesson(int id)
    {
        Navigation.NavigateTo($"/lessons/{id}");
    }
}
