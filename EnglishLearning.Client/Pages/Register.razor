@page "/register"
@layout PublicLayout
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

<PageTitle>Crear Cuenta - English Learning</PageTitle>

<div class="auth-container">
    <div class="glass-panel auth-card">
        <h2 class="text-center">Crea tu cuenta</h2>
        <p class="text-center text-muted mb-4">Empieza tu camino a la fluidez en inglés</p>

        <EditForm Model="@_registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            
            <div class="form-group">
                <label for="nombre">Nombre</label>
                <InputText id="nombre" class="form-control" @bind-Value="_registerModel.Nombre" placeholder="Tu nombre" />
                <ValidationMessage For="@(() => _registerModel.Nombre)" />
            </div>

            <div class="form-group">
                <label for="email">Correo electrónico</label>
                <InputText id="email" class="form-control" @bind-Value="_registerModel.Email" placeholder="tu@correo.com" />
                <ValidationMessage For="@(() => _registerModel.Email)" />
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_registerModel.Password" placeholder="••••••••" @oninput="EvaluatePassword" />
                <ValidationMessage For="@(() => _registerModel.Password)" />
                <div class="password-strength mt-2">
                    <div class="strength-bar @GetStrengthClass()"></div>
                </div>
                <small class="text-muted">Mínimo 8 caracteres, 1 mayúscula, 1 minúscula, 1 número y 1 especial.</small>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4" disabled="@_isLoading">
                @if (_isLoading) { <span class="spinner-small"></span> } else { <span>Registrarse</span> }
            </button>
        </EditForm>

        <p class="auth-footer text-center mt-4">
            ¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>
        </p>
    </div>
</div>

@code {
    public class RegisterForm
    {
        [Required(ErrorMessage = "El nombre es requerido")]
        [MinLength(2, ErrorMessage = "Mínimo 2 caracteres")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "El correo es requerido")] 
        [EmailAddress(ErrorMessage = "Formato de correo inválido")] 
        public string Email { get; set; } = "";
        
        [Required(ErrorMessage = "La contraseña es requerida")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$", ErrorMessage = "La contraseña no cumple con los requisitos mínimos.")]
        public string Password { get; set; } = "";
    }

    private RegisterForm _registerModel = new();
    private bool _isLoading = false;
    private int _passwordStrength = 0;

    private async Task HandleRegister()
    {
        _isLoading = true;
        var req = new RegisterRequest(_registerModel.Nombre, _registerModel.Email, _registerModel.Password);
        var result = await AuthService.RegisterAsync(req);
        _isLoading = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/placement");
        }
        else
        {
            ToastService.ShowError(result.Error?.Message ?? "Error al registrarse");
        }
    }

    private void EvaluatePassword(ChangeEventArgs e)
    {
        var pass = e.Value?.ToString() ?? "";
        _passwordStrength = 0;
        if (pass.Length >= 8) _passwordStrength++;
        if (pass.Any(char.IsUpper)) _passwordStrength++;
        if (pass.Any(char.IsLower)) _passwordStrength++;
        if (pass.Any(char.IsDigit)) _passwordStrength++;
        if (pass.Any(ch => !char.IsLetterOrDigit(ch))) _passwordStrength++;
    }

    private string GetStrengthClass() => _passwordStrength switch
    {
        0 or 1 => "strength-weak",
        2 or 3 => "strength-medium",
        4 or 5 => "strength-strong",
        _ => "strength-weak"
    };
}
