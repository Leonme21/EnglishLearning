@page "/login"
@layout PublicLayout
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService
@implements IDisposable

<PageTitle>Iniciar Sesión - English Learning</PageTitle>

<div class="auth-container">
    <div class="glass-panel auth-card">
        @if (_currentStep == LoginStep.Credentials)
        {
            <h2 class="text-center">Bienvenido de nuevo</h2>
            <p class="text-center text-muted mb-4">Ingresa a tu cuenta para continuar aprendiendo</p>

            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                
                <div class="form-group">
                    <label for="email">Correo electrónico</label>
                    <InputText id="email" class="form-control" autocomplete="username" @bind-Value="_loginModel.Email" placeholder="ejemplo@correo.com" />
                    <ValidationMessage For="@(() => _loginModel.Email)" />
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <InputText id="password" type="password" class="form-control" autocomplete="current-password" @bind-Value="_loginModel.Password" placeholder="••••••••" />
                    <ValidationMessage For="@(() => _loginModel.Password)" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@_isLoading">
                    @if (_isLoading) { <span class="spinner-small"></span> } else { <span>Continuar</span> }
                </button>
            </EditForm>

            <p class="auth-footer text-center mt-4">
                ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>
            </p>
        }
        else
        {
            <div class="text-center mb-3">
                <div style="font-size: 2.5rem; line-height: 1; margin-bottom: 0.5rem;">🔐</div>
                <h2>Verificación de Seguridad</h2>
                <p class="text-muted" style="font-size: 0.95rem; margin-bottom: 0.75rem;">
                    Hemos enviado un código OTP de 6 dígitos a:
                </p>
                <div class="otp-email-badge">
                    <span>✉️</span>
                    <span>@_pendingEmail</span>
                </div>
            </div>

            <div class="form-group text-center">
                <label for="otp-code" style="text-align: center; display: block; margin-bottom: 0.75rem;">
                    Código de verificación
                </label>
                <input id="otp-code" 
                       type="text" 
                       class="otp-input" 
                       maxlength="6" 
                       inputmode="numeric" 
                       autocomplete="one-time-code" 
                       @bind="_otpCode" 
                       @bind:event="oninput" 
                       placeholder="000000" 
                       disabled="@_isVerifying" 
                       autofocus />
                <p class="text-center text-muted" style="font-size: 0.8rem; margin-top: 0.6rem;">
                    ⏱️ Expira en 5 minutos. Revisa también tu carpeta de spam.
                </p>
            </div>

            <button type="button" 
                    class="btn btn-primary w-100 mt-3" 
                    @onclick="HandleVerifyOtp" 
                    disabled="@(_isVerifying || _otpCode.Trim().Length != 6)">
                @if (_isVerifying) 
                { 
                    <span class="spinner-small"></span> 
                    <span style="margin-left: 0.5rem;">Verificando...</span>
                } 
                else 
                { 
                    <span>Verificar e Iniciar Sesión</span> 
                }
            </button>

            <div class="text-center mt-3">
                @if (_resendCountdown > 0)
                {
                    <span class="text-muted" style="font-size: 0.875rem;">
                        Podrás reenviar un código en <strong>@(_resendCountdown)s</strong>
                    </span>
                }
                else
                {
                    <button type="button" 
                            class="btn btn-ghost" 
                            style="font-size: 0.875rem; text-decoration: underline; cursor: pointer;" 
                            @onclick="HandleResendOtp" 
                            disabled="@_isResending">
                        @if (_isResending)
                        {
                            <span class="spinner-small"></span>
                            <span style="margin-left: 0.5rem;">Reenviando...</span>
                        }
                        else
                        {
                            <span>¿No recibiste el código? Reenviar código</span>
                        }
                    </button>
                }
            </div>

            <div class="auth-divider">o</div>

            <button type="button" class="btn btn-secondary w-100" @onclick="BackToCredentials" disabled="@_isVerifying">
                Volver / Cambiar correo
            </button>
        }
    </div>
</div>

@code {
    private enum LoginStep
    {
        Credentials,
        OtpVerification
    }

    public class LoginForm
    {
        [Required(ErrorMessage = "El correo es requerido")] 
        [EmailAddress(ErrorMessage = "Correo inválido")]
        public string Email { get; set; } = "";
        
        [Required(ErrorMessage = "La contraseña es requerida")] 
        public string Password { get; set; } = "";
    }

    private LoginForm _loginModel = new();
    private LoginStep _currentStep = LoginStep.Credentials;
    private string _pendingEmail = "";
    private string _otpCode = "";
    private bool _isLoading = false;
    private bool _isVerifying = false;
    private bool _isResending = false;
    private int _resendCountdown = 0;
    private CancellationTokenSource? _countdownCts;

    private async Task HandleLogin()
    {
        _isLoading = true;
        var req = new LoginRequest(_loginModel.Email.Trim(), _loginModel.Password);
        var result = await AuthService.LoginAsync(req);
        _isLoading = false;

        if (result.IsSuccess)
        {
            if (result.Data?.RequiresOtp == true)
            {
                _pendingEmail = result.Data.Email ?? _loginModel.Email.Trim();
                _otpCode = "";
                _currentStep = LoginStep.OtpVerification;
                ToastService.ShowSuccess("Código de verificación enviado. Revisa tu correo.");
                StartResendCountdown();
            }
            else
            {
                Navigation.NavigateTo("/dashboard");
            }
        }
        else
        {
            ToastService.ShowError(result.Error?.Message ?? "Credenciales inválidas o error de servidor");
        }
    }

    private async Task HandleVerifyOtp()
    {
        if (_otpCode.Trim().Length != 6)
        {
            ToastService.ShowError("El código de verificación debe contener 6 dígitos.");
            return;
        }

        _isVerifying = true;
        var req = new VerifyOtpRequest(_pendingEmail, _otpCode.Trim());
        var result = await AuthService.VerifyOtpAsync(req);
        _isVerifying = false;

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess("¡Identidad verificada exitosamente!");
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            ToastService.ShowError(result.Error?.Message ?? "Código OTP inválido o expirado.");
        }
    }

    private async Task HandleResendOtp()
    {
        _isResending = true;
        var req = new ResendOtpRequest(_pendingEmail);
        var result = await AuthService.ResendOtpAsync(req);
        _isResending = false;

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess("Nuevo código enviado a tu correo.");
            StartResendCountdown();
        }
        else
        {
            ToastService.ShowError(result.Error?.Message ?? "No se pudo reenviar el código. Intenta nuevamente.");
        }
    }

    private void StartResendCountdown()
    {
        _countdownCts?.Cancel();
        _countdownCts = new CancellationTokenSource();
        var token = _countdownCts.Token;
        _resendCountdown = 60;

        _ = InvokeAsync(async () =>
        {
            try
            {
                while (_resendCountdown > 0 && !token.IsCancellationRequested)
                {
                    await Task.Delay(1000, token);
                    _resendCountdown--;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (TaskCanceledException) { }
        });
    }

    private void BackToCredentials()
    {
        _countdownCts?.Cancel();
        _currentStep = LoginStep.Credentials;
        _otpCode = "";
    }

    public void Dispose()
    {
        _countdownCts?.Cancel();
        _countdownCts?.Dispose();
    }
}
