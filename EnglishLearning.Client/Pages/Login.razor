@page "/login"
@layout PublicLayout
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

<PageTitle>Iniciar Sesión - English Learning</PageTitle>

<div class="auth-container">
    <div class="glass-panel auth-card">
        <h2 class="text-center">Bienvenido de nuevo</h2>
        <p class="text-center text-muted mb-4">Ingresa a tu cuenta para continuar aprendiendo</p>

        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            
            <div class="form-group">
                <label for="email">Correo electrónico</label>
                <InputText id="email" class="form-control" @bind-Value="_loginModel.Email" placeholder="ejemplo@correo.com" />
                <ValidationMessage For="@(() => _loginModel.Email)" />
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_loginModel.Password" placeholder="••••••••" />
                <ValidationMessage For="@(() => _loginModel.Password)" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@_isLoading">
                @if (_isLoading) { <span class="spinner-small"></span> } else { <span>Iniciar Sesión</span> }
            </button>
        </EditForm>

        <div class="auth-divider">o</div>
        
        <button class="btn btn-secondary w-100" @onclick="UseDemoAccount" type="button" disabled="@_isLoading">
            Usar cuenta Demo
        </button>

        <p class="auth-footer text-center mt-4">
            ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>
        </p>
    </div>
</div>

@code {
    public class LoginForm
    {
        [Required(ErrorMessage = "El correo es requerido")] 
        [EmailAddress(ErrorMessage = "Correo inválido")]
        public string Email { get; set; } = "";
        
        [Required(ErrorMessage = "La contraseña es requerida")] 
        public string Password { get; set; } = "";
    }

    private LoginForm _loginModel = new();
    private bool _isLoading = false;

    private async Task HandleLogin()
    {
        _isLoading = true;
        var req = new LoginRequest(_loginModel.Email, _loginModel.Password);
        var result = await AuthService.LoginAsync(req);
        _isLoading = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            ToastService.ShowError(result.Error?.Message ?? "Credenciales inválidas o error de servidor");
        }
    }

    private void UseDemoAccount()
    {
        _loginModel.Email = "demo@demo.com";
        _loginModel.Password = "Demo123!";
    }
}
