<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <p role="alert" style="text-align:center; padding: 2rem;">No tienes permisos para ver esta página.</p>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>No encontrado - English Learning</PageTitle>
            <LayoutView Layout="@typeof(PublicLayout)">
                <div class="glass-panel text-center p-5" style="max-width: 500px; margin: 4rem auto;">
                    <h1 style="font-size: 5rem; color: var(--primary-color); margin-bottom: 0;">404</h1>
                    <h3 class="mb-4">Página no encontrada</h3>
                    <p class="text-muted mb-4">Lo sentimos, no pudimos encontrar la página que buscas.</p>
                    <a href="/" class="btn btn-primary" style="text-decoration: none;">Volver al inicio</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
    <Toast />
</CascadingAuthenticationState>
